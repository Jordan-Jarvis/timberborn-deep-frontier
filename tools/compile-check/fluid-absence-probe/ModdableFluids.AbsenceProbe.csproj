<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs in a Mono process without ModdableFluids.dll: references nothing from the API or its consumers. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ModdableFluids.AbsenceProbe</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
