<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FluidsApi.RuntimePrototype</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/FluidsApi/Runtime/*.cs" />
    <ProjectReference Include="../fluid-game-bridge/FluidsApi.GamePrototype.csproj" />
    <ProjectReference Include="../fluid-transport/FluidsApi.TransportPrototype.csproj" />
    <GameReference Include="$(TimberbornManaged)/Timberborn.*.dll;$(TimberbornManaged)/Bindito*.dll;$(TimberbornManaged)/UnityEngine.CoreModule.dll;$(TimberbornManaged)/UnityEngine.UIElementsModule.dll;$(TimberbornManaged)/System.Collections.Immutable.dll;$(TimberbornManaged)/Newtonsoft.Json.dll" />
    <Reference Include="@(GameReference)" Private="false" />
  </ItemGroup>
</Project>
