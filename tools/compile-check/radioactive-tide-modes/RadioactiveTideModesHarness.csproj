<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test harness for the radioactive tide settings of game modes (Scripts/RadioactiveTide/RadioactiveTideGameModeSpec.cs):
       runs the compile check's DeepFrontier.dll (build ../DeepFrontierCompileCheck.csproj first) against the shipped,
       non-publicized game DLLs, with the vanilla game modes from vendor and a mod-added mode like zxuiji's Chill Mode.
         in this folder: dotnet build ../DeepFrontierCompileCheck.csproj, then dotnet run
       Exit code 0 when every case passes. Not part of the official Mod Builder pipeline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <MSBuildWarningsAsMessages>MSB3277;MSB3243</MSBuildWarningsAsMessages>
    <Managed>$(TimberbornManaged)</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DeepFrontier" Private="true">
      <HintPath>$(MSBuildThisFileDirectory)../bin/Debug/netstandard2.1/DeepFrontier.dll</HintPath>
    </Reference>
    <!-- Shipped game assemblies, loaded at run time from the game's Managed folder (Program.cs). -->
    <Reference Include="Timberborn.BlueprintSystem" Private="false"><HintPath>$(Managed)/Timberborn.BlueprintSystem.dll</HintPath></Reference>
    <Reference Include="Timberborn.NewGameConfigurationSystem" Private="false"><HintPath>$(Managed)/Timberborn.NewGameConfigurationSystem.dll</HintPath></Reference>
    <Reference Include="Timberborn.GameSceneLoading" Private="false"><HintPath>$(Managed)/Timberborn.GameSceneLoading.dll</HintPath></Reference>
    <Reference Include="Timberborn.SceneLoading" Private="false"><HintPath>$(Managed)/Timberborn.SceneLoading.dll</HintPath></Reference>
    <Reference Include="Timberborn.MapRepositorySystem" Private="false"><HintPath>$(Managed)/Timberborn.MapRepositorySystem.dll</HintPath></Reference>
    <Reference Include="Timberborn.Persistence" Private="false"><HintPath>$(Managed)/Timberborn.Persistence.dll</HintPath></Reference>
    <Reference Include="Timberborn.WorldPersistence" Private="false"><HintPath>$(Managed)/Timberborn.WorldPersistence.dll</HintPath></Reference>
    <Reference Include="Timberborn.SerializationSystem" Private="false"><HintPath>$(Managed)/Timberborn.SerializationSystem.dll</HintPath></Reference>
    <Reference Include="Timberborn.SettingsSystem" Private="false"><HintPath>$(Managed)/Timberborn.SettingsSystem.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false"><HintPath>$(Managed)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <!-- Timberborn.Common holds the IsExternalInit of the game's init-only setters; SaveReference is in GameSaveRepositorySystem. -->
    <Reference Include="Timberborn.Common" Private="false"><HintPath>$(Managed)/Timberborn.Common.dll</HintPath></Reference>
    <Reference Include="Timberborn.GameSaveRepositorySystem" Private="false"><HintPath>$(Managed)/Timberborn.GameSaveRepositorySystem.dll</HintPath></Reference>
  </ItemGroup>
  <!-- Paths come from ../Directory.Build.props, written for this machine by tools/setup_dev.py. -->
  <Target Name="RequireDevEnvironment" BeforeTargets="ResolveAssemblyReferences" Condition="'$(Managed)' == ''">
    <Error Text="Run &quot;python tools/setup_dev.py&quot; first: tools/compile-check/Directory.Build.props sets this machine's game paths." />
  </Target>
</Project>
