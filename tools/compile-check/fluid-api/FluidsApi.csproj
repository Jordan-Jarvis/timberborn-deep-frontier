<Project Sdk="Microsoft.NET.Sdk">
  <!-- Public Fluids API contract: registry, providers, discovery and save identity. No game or Unity references. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FluidsApi</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The assembly version is declared in source (FluidsApiEntry.cs) for the Unity build too. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/FluidsApi/Api/*.cs" />
  </ItemGroup>
</Project>
