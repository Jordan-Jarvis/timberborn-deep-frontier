<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Deep Frontier scripts with DEEP_FRONTIER_MODDABLE_FLUIDS: the Moddable Fluids migration groundwork
       (src/DeepFrontier/ModdableFluids) replaces the radiation water lockstep and renderer bindings. Compile check only;
       the shipped package never defines the flag. Mirrors ../DeepFrontierCompileCheck.csproj. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DeepFrontier</AssemblyName>
    <RootNamespace>DeepFrontier</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
    <MSBuildWarningsAsMessages>MSB3277;MSB3243</MSBuildWarningsAsMessages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);DEEP_FRONTIER_MODDABLE_FLUIDS</DefineConstants>
    <Managed>$(ModsBuildManaged)</Managed>
    <ScriptsRoot>$(MSBuildThisFileDirectory)../../../src/DeepFrontier/Scripts</ScriptsRoot>
    <GroundworkRoot>$(MSBuildThisFileDirectory)../../../src/DeepFrontier/ModdableFluids</GroundworkRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ScriptsRoot)/**/*.cs" />
    <Compile Include="$(GroundworkRoot)/*.cs" />
    <!-- The optional Moddable Weathers assembly compiles separately (moddable-weathers/). -->
    <Compile Remove="$(ScriptsRoot)/RadioactiveTide/ModdableWeathers/**" />
    <!-- The optional Sluice is Back! assembly compiles separately (sluice-is-back/). -->
    <Compile Remove="$(ScriptsRoot)/SluiceIsBack/**" />
    <!-- The optional Power Lines assembly compiles separately (power-lines/). -->
    <Compile Remove="$(ScriptsRoot)/PowerLines/**" />
  </ItemGroup>
  <ItemGroup>
    <GameDll Include="$(Managed)/*.dll" Exclude="$(Managed)/DeepFrontier.dll;$(Managed)/DeepFrontier.ModdableWeathers.dll;$(Managed)/DeepFrontier.SluiceIsBack.dll;$(Managed)/DeepFrontier.PowerLines.dll;$(Managed)/PowerLines.dll;$(Managed)/ModdableFluids*.dll" />
    <!-- PowerLines.dll is excluded: the main assembly must compile without the optional Power Lines mod. -->
    <Reference Include="@(GameDll)" Private="false" />
    <!-- Built from source (Managed/ModdableFluids*.dll are excluded above): a copy there could be stale. -->
    <Reference Include="ModdableFluids" HintPath="$(MSBuildThisFileDirectory)../fluid-api/bin/$(Configuration)/netstandard2.1/ModdableFluids.dll" Private="false" />
    <!-- Optional dependency (not staged into this Managed folder until a build imports it). The main
         DeepFrontier assembly must compile without using it: the C# compiler emits no reference to an
         unused assembly, and moddable-weathers/ checks that the built DLL has none. -->
    <Reference Include="ModdableWeathers" Private="false">
      <HintPath>$(Workshop)/3630523180/version-1.1/ModdableWeathers.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="BuildModdableFluidsApi" BeforeTargets="ResolveAssemblyReferences">
    <MSBuild Projects="../fluid-api/ModdableFluids.csproj" Properties="Configuration=$(Configuration)" Targets="Build" />
  </Target>
  <!-- Paths come from Directory.Build.props, written for this machine by tools/setup_dev.py. -->
  <Target Name="RequireDevEnvironment" BeforeTargets="ResolveAssemblyReferences" Condition="'$(Workshop)' == '' Or '$(Managed)' == ''">
    <Error Text="Run &quot;python tools/setup_dev.py&quot; first: tools/compile-check/Directory.Build.props sets this machine's game and Workshop paths." />
  </Target>
</Project>
