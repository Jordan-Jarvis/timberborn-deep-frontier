<Project Sdk="Microsoft.NET.Sdk">
  <!-- The optional assembly ModdableFluids.ModdableWeathers (src/ModdableFluids/ModdableWeathers), as the Unity package
       builds it: against the Runtime assembly with the tides (../fluid-tides), the SHIPPED game assemblies (not the
       publicized ModsBuild copies, so a non-public native member fails to compile: the asmdef has no allowUnsafeCode)
       and the installed Moddable Weathers 11.0.0, Moddable Timberborn 11.1.3 and TimberUi from the Workshop.
       The main Moddable Fluids projects reference none of these Workshop assemblies. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ModdableFluids.ModdableWeathers</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/ModdableFluids/ModdableWeathers/*.cs" />
    <ProjectReference Include="../fluid-tides/ModdableFluids.Tides.csproj" />
    <GameReference Include="$(TimberbornManaged)/Timberborn.*.dll;$(TimberbornManaged)/Bindito*.dll;$(TimberbornManaged)/UnityEngine.CoreModule.dll;$(TimberbornManaged)/UnityEngine.UIElementsModule.dll;$(TimberbornManaged)/System.Collections.Immutable.dll;$(TimberbornManaged)/Newtonsoft.Json.dll" />
    <Reference Include="@(GameReference)" Private="false" />
    <Reference Include="0Harmony" HintPath="$(ModsBuildManaged)/0Harmony.dll" Private="false" />
    <Reference Include="ModdableWeathers" HintPath="$(Workshop)/3630523180/version-1.1/ModdableWeathers.dll" Private="false" />
    <Reference Include="ModdableTimberborn" HintPath="$(Workshop)/3578009707/version-1.1/ModdableTimberborn.dll" Private="false" />
    <Reference Include="TimberUi" HintPath="$(Workshop)/3430626620/version-1.1/TimberUi.dll" Private="false" />
  </ItemGroup>
  <!-- Paths come from Directory.Build.props, written for this machine by tools/setup_dev.py. -->
  <Target Name="RequireDevEnvironment" BeforeTargets="ResolveAssemblyReferences" Condition="'$(Workshop)' == '' Or '$(TimberbornManaged)' == ''">
    <Error Text="Run &quot;python tools/setup_dev.py&quot; first: tools/compile-check/Directory.Build.props sets this machine's game and Workshop paths." />
  </Target>
</Project>
