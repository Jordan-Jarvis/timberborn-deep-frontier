<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway compile check for the optional Moddable Weathers assembly (src/DeepFrontier/Scripts/RadioactiveTide/ModdableWeathers)
       against the main compile check's DeepFrontier.dll (build ../DeepFrontierCompileCheck.csproj first), the installed
       game DLLs and the installed Moddable Weathers 11.0.0 / Moddable Timberborn 11.1.3 / TimberUi.
       Not part of the official Mod Builder pipeline. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DeepFrontier.ModdableWeathers</AssemblyName>
    <RootNamespace>DeepFrontier.RadioactiveTideModdableWeathers</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>true</ResolveAssemblyReferenceIgnoreTargetFrameworkAttributeVersionMismatch>
    <MSBuildWarningsAsMessages>MSB3277;MSB3243</MSBuildWarningsAsMessages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Managed>C:/Users/Jordan/Documents/Timberborn/ModsBuild/TimberbornModExamples_Data/Managed</Managed>
    <Workshop>C:/Program Files (x86)/Steam/steamapps/workshop/content/1062090</Workshop>
    <SourceRoot>$(MSBuildThisFileDirectory)../../../src/DeepFrontier/Scripts/RadioactiveTide/ModdableWeathers</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <GameDll Include="$(Managed)/*.dll" Exclude="$(Managed)/DeepFrontier.dll;$(Managed)/DeepFrontier.ModdableWeathers.dll;$(Managed)/ModdableTimberborn.dll;$(Managed)/TimberUi.dll" />
    <Reference Include="@(GameDll)" Private="false" />
    <Reference Include="DeepFrontier" Private="false">
      <HintPath>$(MSBuildThisFileDirectory)../bin/Debug/netstandard2.1/DeepFrontier.dll</HintPath>
    </Reference>
    <Reference Include="ModdableWeathers" Private="false">
      <HintPath>$(Workshop)/3630523180/version-1.1/ModdableWeathers.dll</HintPath>
    </Reference>
    <Reference Include="ModdableTimberborn" Private="false">
      <HintPath>$(Workshop)/3578009707/version-1.1/ModdableTimberborn.dll</HintPath>
    </Reference>
    <Reference Include="TimberUi" Private="false">
      <HintPath>$(Workshop)/3430626620/version-1.1/TimberUi.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
